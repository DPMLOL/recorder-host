@@ -171,6 +171,27 @@ char *get_hook_path(bool b64)
 #undef warn
 #define warn(format, ...) blog(LOG_WARNING, "update_hook_file: " format, ##__VA_ARGS__)
 
+static bool files_differ(const wchar_t *a, const wchar_t *b)
+{
+	bool differ = true;
+	HANDLE fa = CreateFileW(a, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_DELETE, NULL, OPEN_EXISTING, 0, NULL);
+	HANDLE fb = CreateFileW(b, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL, OPEN_EXISTING, 0, NULL);
+	LARGE_INTEGER sa, sb;
+	if (fa != INVALID_HANDLE_VALUE && fb != INVALID_HANDLE_VALUE && GetFileSizeEx(fa, &sa) && GetFileSizeEx(fb, &sb) &&
+	    sa.QuadPart == sb.QuadPart) {
+		char ba[65536], bb[65536];
+		DWORD ra = 0, rb = 0;
+		differ = false;
+		while (!differ && ReadFile(fa, ba, sizeof(ba), &ra, NULL) && ReadFile(fb, bb, sizeof(bb), &rb, NULL) && ra > 0)
+			differ = ra != rb || memcmp(ba, bb, ra) != 0;
+	}
+	if (fa != INVALID_HANDLE_VALUE)
+		CloseHandle(fa);
+	if (fb != INVALID_HANDLE_VALUE)
+		CloseHandle(fb);
+	return differ;
+}
+
 static bool update_hook_file(bool b64)
 {
 	wchar_t temp[MAX_PATH];
@@ -199,7 +220,7 @@ static bool update_hook_file(bool b64)
 		return false;
 	}
 
-	get_programdata_path(temp, L"obs-studio-hook\\");
